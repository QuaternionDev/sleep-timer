<?xml version="1.0" encoding="utf-8"?>
<!--
  Full widget (4x4): everything the main screen offers, so the app never has to be opened.
  Header toggles, -5/+5 around the value, presets, fade length, and Start / Cancel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_stat_timer"
            android:tint="@color/accent"
            android:contentDescription="@string/widget_title"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/widget_screen_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_off"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/widget_screen_off"
            android:textColor="@color/on_bg_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_chip_off"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/widget_lock"
            android:textColor="@color/on_bg_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- -5 | value | +5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_minus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_round_bg"
            android:gravity="center"
            android:text="@string/widget_minus"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/widget_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="@color/accent"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <Chronometer
                    android:id="@+id/widget_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minutes"
                android:textColor="@color/on_bg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_plus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_round_bg"
            android:gravity="center"
            android:text="@string/widget_plus"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Presets: always live, so they also re-arm a running timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_preset_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/preset_15"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/preset_30"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/preset_45"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/preset_60"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/preset_90"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fade-out length -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_fade"
            android:textColor="@color/on_bg_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_fade_minus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_round_bg"
            android:gravity="center"
            android:text="@string/widget_fade_minus"
            android:textColor="@color/on_bg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fade_value"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_fade_default"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fade_plus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_round_bg"
            android:gravity="center"
            android:text="@string/widget_fade_plus"
            android:textColor="@color/on_bg"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Start / Cancel -->
    <TextView
        android:id="@+id/widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_primary_bg"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/start"
        android:textColor="@color/accent_on"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
