<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard widget (4x2): header with the two toggles, the selected duration or a live
  countdown, then presets when idle / adjust + cancel while running.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_stat_timer"
            android:tint="@color/accent"
            android:contentDescription="@string/widget_title"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/widget_screen_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_off"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_screen_off"
            android:textColor="@color/on_bg_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_chip_off"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_lock"
            android:textColor="@color/on_bg_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Selected duration (idle) or countdown (running) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <!-- Caption last, so it reads "30 minutes" idle and "24:13 remaining" running -->
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="3dp"
            android:text="@string/minutes"
            android:textColor="@color/on_bg_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Presets (idle) -->
    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_preset_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/preset_15"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/preset_30"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/preset_45"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/preset_60"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/preset_90"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Adjust / cancel (running) -->
    <LinearLayout
        android:id="@+id/widget_running"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_minus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/widget_minus"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_plus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/widget_plus"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_cancel_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/action_cancel"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
