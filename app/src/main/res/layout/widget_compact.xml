<?xml version="1.0" encoding="utf-8"?>
<!-- One-line widget (4x1). Idle: five presets. Running: countdown, +5 and Stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="@drawable/widget_bg_compact"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_stat_timer"
        android:tint="@color/accent"
        android:contentDescription="@string/widget_title"
        tools:ignore="UseAppTint" />

    <!-- IDLE -->
    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_preset_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/preset_15"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/preset_30"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/preset_45"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/preset_60"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/preset_90"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RUNNING -->
    <LinearLayout
        android:id="@+id/widget_running"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:visibility="gone">

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preset_bg"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/widget_plus"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_cancel_bg"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/stop"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
